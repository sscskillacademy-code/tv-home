<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- frosted glass: a touch brighter at the top, like light falling on it -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <gradient android:angle="270" android:startColor="#24FFFFFF" android:centerColor="#12FFFFFF" android:endColor="#0AFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
