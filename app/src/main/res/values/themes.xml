<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GlassHome" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#7FDCFF</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
        <!-- strong, coloured shadows = the glow under the focused app -->
        <item name="android:ambientShadowAlpha">0.35</item>
        <item name="android:spotShadowAlpha">0.8</item>
    </style>
</resources>
